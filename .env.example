# ─────────────────────────────────────────────────────────────
# Radar Lavacar (LeadHunter v3) · variáveis de ambiente
# No EasyPanel: serviço "radar" → Ambiente (uma variável por linha).
# Localmente: copie para .env.local e preencha.
# Passo a passo completo: docs/SETUP.md
# ─────────────────────────────────────────────────────────────

# Senha única de acesso ao app (obrigatória).
APP_PASSWORD=

# Opcional: segredo para assinar a sessão. Se vazio, é derivado da senha.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Chave da Google Places API (New) (obrigatória).
GOOGLE_MAPS_API_KEY=

# Chave JSON da conta de serviço do Google (obrigatória), em base64 (uma linha)
# ou o JSON em uma linha. Veja docs/SETUP.md (passo 4.3) para gerar o base64.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Planilha "Leads Lava-jatos" (já vem com este ID como padrão).
SHEET_ID=180iMVX1oA3oJ0IVBlsnGkFPq_2p4pEtNMZ8zhSUlP1g
# Aba onde os leads entram.
SHEET_TAB=leads
# Status gravado nos leads novos (a Carol dispara a mensagem para estes).
SHEET_DEFAULT_STATUS=pendente
# Abas extras: telefone que aparece nelas também não é reenviado.
# Padrão: historico_carol,historico_sofia. Use "nenhuma" para desligar.
DEDUP_EXTRA_TABS=historico_carol,historico_sofia

# Máximo de consultas que uma busca pode gastar (o campo "Mudar o máximo" não passa disso).
MAX_REQUESTS_PER_SEARCH=200

# Consultas grátis por mês do Google (Text Search Enterprise = 1.000). Renova todo dia 1º,
# 00:00 no horário do Pacífico (04:00 ou 05:00 em Brasília).
LIMITE_MENSAL_CONSULTAS=1000
# 1 = o Radar para de buscar quando as grátis acabam (nada é cobrado). 0 = deixa passar.
BLOQUEAR_NO_LIMITE=1
# Opcional: projeto do Google Cloud da chave do Places (padrão: o da conta de serviço).
GOOGLE_CLOUD_PROJECT=

# Botão "Disparar" (tela Disparo): Production URL do nó Webhook "Disparo pelo Radar" do Fluxo 1 no n8n.
N8N_DISPARO_URL=
# Opcional: se o nó usar Header Auth, o valor da credencial (cabeçalho X-Radar-Token).
N8N_DISPARO_TOKEN=
N8N_DISPARO_HEADER=X-Radar-Token
# Só para mostrar na tela: o limite diário da Carol (o que vale é o do nó "Inicializar Limite Diário" do
# Fluxo 1). Com a trava instalada, o Radar aprende o número certo sozinho no primeiro disparo.
LIMITE_DIARIO_CAROL=10
# Opcional: chave fixa da trava do disparo (nó "Radar: Pode Enviar?" do n8n). Sem ela, a chave é derivada
# do código do webhook em N8N_DISPARO_URL (o mesmo segredo que o n8n já tem). Se trocar o webhook, copie
# os nós da trava de novo (Configuração → Trava do disparo).
N8N_TRAVA_CHAVE=
# Status de quem está na fila mas não foi marcado num disparo (o n8n só dispara "pendente").
STATUS_AGUARDANDO=aguardando
# Telefones que nunca entram nas buscas, na planilha nem no disparo (padrão: o do próprio Lavacar).
TELEFONES_BLOQUEADOS=5531982149012

# Atendimento (Chatwoot): tela que o botão "Atendimento" (e o atalho Alt + A) abre.
CHATWOOT_URL=https://chat.lavacar.app/app/accounts/1/custom_view/6
# Opcional: token de acesso de um agente do Chatwoot (Configurações do perfil → Token de acesso). Com ele,
# "Atender" abre a conversa exata do contato.
CHATWOOT_TOKEN=
# Opcional: endereço da API visto do servidor (ex.: http://n8n_chatwoot:3000 na rede interna do EasyPanel).
CHATWOOT_API_URL=

# Desempenho dos disparos: abas que o n8n grava (conversa, status da Meta e etapa da conversa).
# As colunas são reconhecidas pelo nome (diagnóstico em /api/painel, campo "fontes").
PAINEL_ABA_HISTORICO=historico_carol
PAINEL_ABA_STATUS=status_meta_carol
PAINEL_ABA_SESSOES=sessoes_carol

# Só para desenvolvimento: 1 = dados falsos e planilha em memória.
# É ignorado na imagem Docker (LEADHUNTER_PRODUCAO=1) e na produção da Vercel.
MOCK_MODE=
